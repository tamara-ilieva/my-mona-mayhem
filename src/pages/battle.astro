<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<title>Mona Mayhem - Battle Arena</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Arial', sans-serif;
			background: #000033;
			color: #ffff00;
			min-height: 100vh;
			padding: 20px;
			overflow-x: hidden;
		}

		header {
			text-align: center;
			margin-bottom: 40px;
		}

		h1 {
			font-size: clamp(2rem, 8vw, 4rem);
			text-transform: uppercase;
			font-weight: bold;
			letter-spacing: 2px;
			margin-bottom: 10px;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			animation: pacmanBounce 1s ease-in-out infinite;
		}

		header p {
			font-size: 1.2rem;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #00ffff;
			text-shadow: 1px 1px 0 #333;
			margin-bottom: 20px;
		}

		.nav-buttons {
			display: flex;
			gap: 10px;
			justify-content: center;
			flex-wrap: wrap;
		}

		.nav-btn {
			padding: 8px 20px;
			font-size: 0.9rem;
			text-transform: uppercase;
			background: #001a4d;
			border: 2px solid #00ffff;
			color: #00ffff;
			cursor: pointer;
			transition: all 0.2s ease;
			font-family: 'Arial', sans-serif;
		}

		.nav-btn:hover {
			background: #002d7a;
			transform: scale(1.05);
		}

		.nav-btn.active {
			background: #ffff00;
			color: #000033;
			border-color: #ffff00;
			text-shadow: 1px 1px 0 #333;
		}

		.container {
			max-width: 1200px;
			margin: 0 auto;
		}

		.setup-section {
			display: flex;
			flex-direction: column;
			gap: 20px;
			margin-bottom: 40px;
			border: 3px solid #ffff00;
			padding: 30px;
			background: #001a4d;
		}

		.player-list {
			border: 2px solid #00ffff;
			padding: 20px;
			background: #000066;
			border-radius: 5px;
			margin-bottom: 20px;
		}

		.player-list h3 {
			text-transform: uppercase;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			margin-bottom: 15px;
			letter-spacing: 1px;
		}

		.player-input-row {
			display: flex;
			gap: 10px;
			margin-bottom: 10px;
		}

		.player-input-row input {
			flex: 1;
			padding: 10px 15px;
			font-size: 1rem;
			font-family: 'Arial', sans-serif;
			background: #000066;
			border: 2px solid #00ffff;
			color: #ffff00;
			text-transform: lowercase;
			transition: all 0.2s ease;
			outline: none;
		}

		.player-input-row input:focus {
			background: #000099;
			border-color: #ffff00;
			transform: scale(1.02);
		}

		.player-input-row button {
			padding: 10px 20px;
			font-size: 0.9rem;
			text-transform: uppercase;
			background: #ff0000;
			border: 2px solid #ff0000;
