			font-family: 'Arial', sans-serif;
		}

		.player-input-row button:hover {
			background: #cc0000;
			transform: scale(1.05);
		}

		.players-display {
			display: flex;
			flex-wrap: wrap;
			gap: 10px;
		}

		.player-badge {
			background: linear-gradient(90deg, #00ffff, #ff00ff);
			color: #000033;
			padding: 8px 15px;
			border-radius: 5px;
			font-weight: bold;
			text-transform: uppercase;
			font-size: 0.9rem;
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.player-badge button {
			background: rgba(0, 0, 51, 0.5);
			border: none;
			color: #000033;
			cursor: pointer;
			padding: 0 5px;
			font-size: 0.8rem;
			transition: all 0.2s ease;
		}

		.player-badge button:hover {
