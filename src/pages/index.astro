<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Arial', sans-serif;
			background: #000033;
			color: #ffff00;
			min-height: 100vh;
			padding: 20px;
			overflow-x: hidden;
		}

		header {
			text-align: center;
			margin-bottom: 40px;
		}

		h1 {
			font-size: clamp(2rem, 8vw, 4rem);
			text-transform: uppercase;
			font-weight: bold;
			letter-spacing: 2px;
			margin-bottom: 10px;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			animation: pacmanBounce 1s ease-in-out infinite;
		}

		header p {
			font-size: 1.2rem;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #00ffff;
			text-shadow: 1px 1px 0 #333;
			margin-bottom: 20px;
		}

		.nav-buttons {
			display: flex;
			gap: 10px;
			justify-content: center;
			flex-wrap: wrap;
		}

		.nav-btn {
			padding: 8px 20px;
			font-size: 0.9rem;
			text-transform: uppercase;
			background: #001a4d;
			border: 2px solid #00ffff;
			color: #00ffff;
			cursor: pointer;
			transition: all 0.2s ease;
			font-family: 'Arial', sans-serif;
		}

		.nav-btn:hover {
			background: #002d7a;
			transform: scale(1.05);
		}

		.nav-btn.active {
			background: #ffff00;
			color: #000033;
			border-color: #ffff00;
			text-shadow: 1px 1px 0 #333;
		}

		.container {
			max-width: 1200px;
			margin: 0 auto;
		}

		.battle-setup {
			display: flex;
			flex-direction: column;
			gap: 20px;
			margin-bottom: 40px;
			border: 3px solid #ffff00;
			padding: 30px;
			background: #001a4d;
		}

		.inputs-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 20px;
			margin-bottom: 20px;
		}

		.player-input {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.player-input label {
			font-size: 1.1rem;
			text-transform: uppercase;
			font-weight: bold;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			letter-spacing: 1px;
		}

		.player-input input {
			padding: 15px 20px;
			font-size: 1.1rem;
			font-family: 'Arial', sans-serif;
			background: #000066;
			border: 2px solid #00ffff;
			color: #ffff00;
			text-transform: lowercase;
			transition: all 0.2s ease;
			outline: none;
		}

		.player-input input:focus {
			background: #000099;
			border-color: #ffff00;
			transform: scale(1.02);
		}

		.player-input input::placeholder {
			color: #0099ff;
		}

		.button-group {
			display: flex;
			gap: 10px;
			justify-content: center;
		}

		button {
			padding: 15px 40px;
			font-size: 1.2rem;
			font-weight: bold;
			text-transform: uppercase;
			letter-spacing: 2px;
			background: linear-gradient(90deg, #ffff00, #ff00ff);
			color: #000033;
			border: 2px solid #ffff00;
			cursor: pointer;
			transition: all 0.2s ease;
			font-family: 'Arial', sans-serif;
		}

		button:hover:not(:disabled) {
			transform: scale(1.05);
			background: linear-gradient(90deg, #ffff00, #ffff00);
		}

		button:active:not(:disabled) {
			transform: scale(0.98);
		}

		button:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}

		.new-battle-btn {
			margin-top: 30px;
			background: linear-gradient(90deg, #00ffff, #00ffff);
			border-color: #00ffff;
		}

		#loading {
			text-align: center;
			font-size: 1.5rem;
			padding: 40px;
		}

		.loader {
			display: inline-block;
			width: 60px;
			height: 60px;
			animation: pacmanEat 0.6s ease-in-out infinite;
		}

		.loader::before {
			content: '';
			display: block;
			width: 100%;
			height: 100%;
			background: #ffff00;
			border-radius: 50%;
			clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%);
		}

		.loading-text {
			margin-top: 20px;
			text-transform: uppercase;
			text-shadow: 1px 1px 0 #333;
			animation: pulse 1.5s ease-in-out infinite;
			letter-spacing: 2px;
		}

		#error {
			background: rgba(255, 0, 0, 0.2);
			border: 2px solid #ff0000;
			border-radius: 5px;
			padding: 20px;
			text-align: center;
			font-size: 1.1rem;
			color: #ff0000;
			text-shadow: 1px 1px 0 #333;
			animation: slideInUp 0.3s ease-out;
		}

		.hidden {
			display: none !important;
		}

		#results {
			animation: slideInUp 0.8s ease-out;
		}

		.winner-banner {
			background: linear-gradient(135deg, #ffff00, #ff00ff);
			border: 3px solid #ffff00;
			border-radius: 10px;
			padding: 40px;
			text-align: center;
			margin-bottom: 40px;
			animation: slideInDown 0.6s ease-out;
		}

		.winner-banner h2 {
			font-size: 3rem;
			text-transform: uppercase;
			color: #000033;
			text-shadow: 2px 2px 0 #ffff00;
			margin-bottom: 10px;
			letter-spacing: 2px;
			animation: pacmanBounce 1s ease-in-out infinite;
		}

		.winner-banner p {
			font-size: 1.3rem;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #000033;
			text-shadow: 1px 1px 0 #ffff00;
			margin: 5px 0;
			font-weight: bold;
		}

		.battle-stats {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 30px;
			margin-bottom: 40px;
		}

		.player-stats {
			background: #001a4d;
			border: 2px solid #00ffff;
			border-radius: 5px;
			padding: 25px;
			animation: slideInLeft 0.6s ease-out;
		}

		.player-stats:nth-child(2) {
			animation: slideInRight 0.6s ease-out;
		}

		.player-stats h3 {
			font-size: 1.5rem;
			text-transform: uppercase;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			margin-bottom: 15px;
			border-bottom: 2px solid #ff00ff;
			padding-bottom: 10px;
			letter-spacing: 1px;
		}

		.player-stats ul {
			list-style: none;
		}

		.player-stats li {
			font-size: 1.1rem;
			margin: 12px 0;
			display: flex;
			justify-content: space-between;
			align-items: center;
			color: #00ffff;
			text-shadow: 1px 1px 0 #333;
		}

		.player-stats strong {
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			font-size: 1.2rem;
		}

		.contribution-graphs {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 30px;
			margin-bottom: 40px;
		}

		.graph {
			background: #001a4d;
			border: 2px solid #00ffff;
			border-radius: 5px;
			padding: 20px;
			animation: slideInUp 0.8s ease-out;
		}

		.graph h4 {
			font-size: 1.2rem;
			text-transform: uppercase;
			color: #ffff00;
			text-shadow: 1px 1px 0 #333;
			margin-bottom: 15px;
			text-align: center;
			letter-spacing: 1px;
		}

		canvas {
			width: 100%;
			height: auto;
			display: block;
		}

		@keyframes pacmanBounce {
			0%, 100% { transform: translateY(0); }
			50% { transform: translateY(-15px); }
		}

		@keyframes pacmanEat {
			0%, 100% { clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); }
			50% { clip-path: polygon(30% 0%, 70% 0%, 100% 50%, 70% 100%, 30% 100%, 0% 50%); }
		}

		@keyframes slideInDown {
			from { opacity: 0; transform: translateY(-30px); }
			to { opacity: 1; transform: translateY(0); }
		}

		@keyframes slideInUp {
			from { opacity: 0; transform: translateY(30px); }
			to { opacity: 1; transform: translateY(0); }
		}

		@keyframes slideInLeft {
			from { opacity: 0; transform: translateX(-40px); }
			to { opacity: 1; transform: translateX(0); }
		}

		@keyframes slideInRight {
			from { opacity: 0; transform: translateX(40px); }
			to { opacity: 1; transform: translateX(0); }
		}

		@keyframes pulse {
			0%, 100% { opacity: 0.7; }
			50% { opacity: 1; }
		}

		@media (max-width: 768px) {
			.inputs-grid {
				grid-template-columns: 1fr;
			}

			.battle-stats {
				grid-template-columns: 1fr;
			}

			.contribution-graphs {
				grid-template-columns: 1fr;
			}

			.winner-banner {
				padding: 25px;
			}

			.winner-banner h2 {
				font-size: 2rem;
			}
		}
	</style>
</head>
<body>
	<div class="container">
		<header>
			<h1>MONA MAYHEM</h1>
			<p>Github Contribution Battle Arena</p>
			<div class="nav-buttons">
				<button class="nav-btn active" onclick="location.href='/'">1v1 Battle</button>
				<button class="nav-btn" onclick="location.href='/battle'">N-Player</button>
			</div>
		</header>

		<div class="battle-setup">
			<div class="inputs-grid">
				<div class="player-input">
					<label for="player1">Player 1</label>
					<input type="text" id="player1" placeholder="Enter username" />
				</div>
				<div class="player-input">
					<label for="player2">Player 2</label>
					<input type="text" id="player2" placeholder="Enter username" />
				</div>
			</div>

			<div class="button-group">
				<button id="battle-btn">BATTLE!</button>
			</div>

			<div id="loading" class="hidden">
				<div class="loader"></div>
				<div class="loading-text">Eating Pellets...</div>
			</div>

			<div id="error" class="hidden"></div>
		</div>

		<section id="results" class="hidden">
			<div class="winner-banner">
				<h2 id="winner-title">VICTORY!</h2>
				<p id="winner-name"></p>
				<p id="victory-margin"></p>
			</div>

			<div class="battle-stats">
				<div class="player-stats player-1-stats">
					<h3 id="p1-name"></h3>
					<ul>
						<li>Total Contributions <strong id="p1-total">0</strong></li>
						<li>Date Range <strong id="p1-date-range">-</strong></li>
						<li>Weeks Tracked <strong id="p1-weeks">0</strong></li>
						<li>Avg per Week <strong id="p1-avg">0</strong></li>
						<li>Best Week <strong id="p1-best">0</strong></li>
					</ul>
				</div>

				<div class="player-stats player-2-stats">
					<h3 id="p2-name"></h3>
					<ul>
						<li>Total Contributions <strong id="p2-total">0</strong></li>
						<li>Date Range <strong id="p2-date-range">-</strong></li>
						<li>Weeks Tracked <strong id="p2-weeks">0</strong></li>
						<li>Avg per Week <strong id="p2-avg">0</strong></li>
						<li>Best Week <strong id="p2-best">0</strong></li>
					</ul>
				</div>
			</div>

			<div class="contribution-graphs">
				<div class="graph">
					<h4 id="p1-graph-title">Contributions</h4>
					<canvas id="graph1"></canvas>
				</div>
				<div class="graph">
					<h4 id="p2-graph-title">Contributions</h4>
					<canvas id="graph2"></canvas>
				</div>
			</div>

			<div class="button-group">
				<button id="new-battle-btn" class="new-battle-btn">New Battle</button>
			</div>
		</section>
	</div>

	<canvas id="particle-canvas" style="position: fixed; top: 0; left: 0; pointer-events: none;"></canvas>

	<script>
		const PARTICLE_CANVAS = document.getElementById('particle-canvas');
		const PARTICLE_CTX = PARTICLE_CANVAS.getContext('2d');
		let particles = [];

		PARTICLE_CANVAS.width = window.innerWidth;
		PARTICLE_CANVAS.height = window.innerHeight;

		window.addEventListener('resize', () => {
			PARTICLE_CANVAS.width = window.innerWidth;
			PARTICLE_CANVAS.height = window.innerHeight;
		});

		// Pac-Man style particles (pellets)
		class Pellet {
			constructor(x, y, vx, vy, color, life = 1.5) {
				this.x = x;
				this.y = y;
				this.vx = vx;
				this.vy = vy;
				this.color = color;
				this.life = life;
				this.maxLife = life;
				this.size = Math.random() * 3 + 2;
			}

			update() {
				this.x += this.vx;
				this.y += this.vy;
				this.vy += 0.1;
				this.life -= 1 / 60;
			}

			draw(ctx) {
				ctx.save();
				ctx.globalAlpha = Math.max(0, this.life / this.maxLife);
				ctx.fillStyle = this.color;
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			}
		}

		function createPellets(x, y, count = 20) {
			const colors = ['#ffff00', '#ff00ff', '#00ffff'];
			for (let i = 0; i < count; i++) {
				const angle = (Math.PI * 2 * i) / count;
				const velocity = 4 + Math.random() * 3;
				particles.push(
					new Pellet(
						x,
						y,
						Math.cos(angle) * velocity,
						Math.sin(angle) * velocity - 3,
						colors[Math.floor(Math.random() * colors.length)],
						1.5,
					),
				);
			}
		}

		function updateParticles() {
			particles = particles.filter(p => p.life > 0);
			particles.forEach(p => p.update());
		}

		function drawParticles() {
			particles.forEach(p => p.draw(PARTICLE_CTX));
		}

		function animateParticles() {
			PARTICLE_CTX.clearRect(0, 0, PARTICLE_CANVAS.width, PARTICLE_CANVAS.height);
			updateParticles();
			drawParticles();
			if (particles.length > 0) {
				requestAnimationFrame(animateParticles);
			}
		}

		// Graph rendering with Pac-Man colors
		function drawContributionGraph(canvas, data, maxWeeks = 52) {
			const ctx = canvas.getContext('2d');
			const weeks = data.weeks || [];

			canvas.width = canvas.offsetWidth * window.devicePixelRatio;
			canvas.height = canvas.offsetHeight * window.devicePixelRatio;
			ctx.scale(window.devicePixelRatio, window.devicePixelRatio);

			const width = canvas.width / window.devicePixelRatio;
			const height = canvas.height / window.devicePixelRatio;

			const displayWeeks = Math.min(weeks.length, maxWeeks);
			const barWidth = (width - 40) / displayWeeks;
			const barHeight = height - 40;

			const maxContributions = Math.max(
				...weeks.flatMap(w => w.contribution_days || []).map(d => d.count || 0),
				1,
			);

			const pacmanColors = ['#001a4d', '#0066ff', '#00ccff', '#ffff00'];

			let delay = 0;
			weeks.slice(-displayWeeks).forEach((week, idx) => {
				const totalWeekContributions = (week.contribution_days || []).reduce(
					(sum, day) => sum + (day.count || 0),
					0,
				);
				const level = Math.min(3, Math.floor((totalWeekContributions / maxContributions) * 3));
				const color = pacmanColors[level];

				setTimeout(() => {
					const x = 20 + idx * barWidth + barWidth * 0.1;
					const y = 20 + barHeight * (1 - totalWeekContributions / maxContributions);
					const w = barWidth * 0.8;
					const h = barHeight * (totalWeekContributions / maxContributions);

					ctx.fillStyle = color;
					ctx.fillRect(x, y, w, h);
					ctx.strokeStyle = '#00ffff';
					ctx.lineWidth = 1;
					ctx.strokeRect(x, y, w, h);
				}, delay);

				delay += 30;
			});
		}

		// Stats calculation
		function calculateStats(data) {
			const weeks = data.weeks || [];
			const total = data.total_contributions || 0;
			const from = data.from || 'unknown';
			const to = data.to || 'unknown';
			const weeksCount = weeks.length;

			let bestWeek = 0;
			weeks.forEach(week => {
				const weekTotal = (week.contribution_days || []).reduce(
					(sum, day) => sum + (day.count || 0),
					0,
				);
				bestWeek = Math.max(bestWeek, weekTotal);
			});

			const avgPerWeek = weeksCount > 0 ? Math.round(total / weeksCount) : 0;

			return {
				total,
				from,
				to,
				weeksCount,
				avgPerWeek,
				bestWeek,
				data,
			};
		}

		// Number count-up animation
		function animateNumber(element, target, duration = 1000) {
			const increment = target / (duration / 16);
			let current = 0;

			const interval = setInterval(() => {
				current += increment;
				if (current >= target) {
					current = target;
					clearInterval(interval);
				}
				element.textContent = Math.round(current).toLocaleString();
			}, 16);
		}

		// Fetch and compare battle
		async function executeBattle() {
			const player1 = document.getElementById('player1').value.trim().toLowerCase();
			const player2 = document.getElementById('player2').value.trim().toLowerCase();

			// Validation
			if (!player1 || !player2) {
				showError('Enter both usernames!');
				return;
			}

			if (player1 === player2) {
				showError('Players must have different usernames!');
				return;
			}

			// Show loading
			document.getElementById('loading').classList.remove('hidden');
			document.getElementById('error').classList.add('hidden');

			try {
				// Fetch both concurrently
				const [res1, res2] = await Promise.all([
					fetch(`/api/contributions/${player1}`),
					fetch(`/api/contributions/${player2}`),
				]);

				if (!res1.ok || !res2.ok) {
					const error1 = !res1.ok ? await res1.json() : null;
					const error2 = !res2.ok ? await res2.json() : null;
					throw new Error(
						error1?.message || error2?.message || 'Failed to fetch data',
					);
				}

				const data1 = await res1.json();
				const data2 = await res2.json();

				// Calculate stats
				const stats1 = calculateStats(data1);
				const stats2 = calculateStats(data2);

				// Determine winner
				const winner = stats1.total > stats2.total ? 1 : stats1.total < stats2.total ? 2 : 0;
				const margin = Math.abs(stats1.total - stats2.total);

				// Hide loading, show results
				document.getElementById('loading').classList.add('hidden');
				displayResults(player1, player2, stats1, stats2, winner, margin);

				// Pellet burst
				createPellets(window.innerWidth / 2, window.innerHeight / 3, 15);
				animateParticles();
			} catch (error) {
				document.getElementById('loading').classList.add('hidden');
				showError(error.message);
			}
		}

		function showError(message) {
			const errorEl = document.getElementById('error');
			errorEl.textContent = message;
			errorEl.classList.remove('hidden');
		}

		function displayResults(p1Name, p2Name, stats1, stats2, winner, margin) {
			// Update winner banner
			if (winner === 0) {
				document.getElementById('winner-title').textContent = 'TIE!';
				document.getElementById(
					'winner-name',
				).textContent = `${p1Name} and ${p2Name} are equally matched`;
				document.getElementById('victory-margin').textContent = 'No difference';
			} else {
				const winnerName = winner === 1 ? p1Name : p2Name;
				document.getElementById('winner-title').textContent = 'VICTORY!';
				document.getElementById('winner-name').textContent = winnerName.toUpperCase();
				document.getElementById(
					'victory-margin',
				).textContent = `+${margin.toLocaleString()} contributions`;
			}

			// Update player 1 stats
			document.getElementById('p1-name').textContent = p1Name.toUpperCase();
			document.getElementById('p1-total').textContent = '0';
			document.getElementById('p1-date-range').textContent = `${stats1.from} - ${stats1.to}`;
			document.getElementById('p1-weeks').textContent = stats1.weeksCount;
			document.getElementById('p1-avg').textContent = '0';
			document.getElementById('p1-best').textContent = stats1.bestWeek.toLocaleString();
			document.getElementById(
				'p1-graph-title',
			).textContent = `${p1Name.toUpperCase()} Contributions`;

			// Update player 2 stats
			document.getElementById('p2-name').textContent = p2Name.toUpperCase();
			document.getElementById('p2-total').textContent = '0';
			document.getElementById('p2-date-range').textContent = `${stats2.from} - ${stats2.to}`;
			document.getElementById('p2-weeks').textContent = stats2.weeksCount;
			document.getElementById('p2-avg').textContent = '0';
			document.getElementById('p2-best').textContent = stats2.bestWeek.toLocaleString();
			document.getElementById(
				'p2-graph-title',
			).textContent = `${p2Name.toUpperCase()} Contributions`;

			// Animate numbers
			setTimeout(() => {
				animateNumber(document.getElementById('p1-total'), stats1.total, 1000);
				animateNumber(document.getElementById('p1-avg'), stats1.avgPerWeek, 1000);
				animateNumber(document.getElementById('p2-total'), stats2.total, 1000);
				animateNumber(document.getElementById('p2-avg'), stats2.avgPerWeek, 1000);
			}, 300);

			// Draw graphs
			setTimeout(() => {
				drawContributionGraph(document.getElementById('graph1'), stats1.data);
				drawContributionGraph(document.getElementById('graph2'), stats2.data);
			}, 100);

			// Show results
			document.getElementById('results').classList.remove('hidden');
		}

		function resetBattle() {
			document.getElementById('battle-setup').scrollIntoView({ behavior: 'smooth' });
			document.getElementById('player1').value = '';
			document.getElementById('player2').value = '';
			document.getElementById('results').classList.add('hidden');
			document.getElementById('error').classList.add('hidden');
			particles = [];
		}

		// Event listeners
		document.getElementById('battle-btn').addEventListener('click', executeBattle);
		document.getElementById('new-battle-btn').addEventListener('click', resetBattle);

		document.getElementById('player1').addEventListener('keypress', e => {
			if (e.key === 'Enter') {
				executeBattle();
			}
		});

		document.getElementById('player2').addEventListener('keypress', e => {
			if (e.key === 'Enter') {
				executeBattle();
			}
		});

		// Pellet burst on button click
		document.getElementById('battle-btn').addEventListener('click', function(e) {
			createPellets(e.clientX, e.clientY, 10);
			animateParticles();
		});

		// Auto-focus on load
		window.addEventListener('load', () => {
			document.getElementById('player1').focus();
		});
	</script>
</body>
</html>
